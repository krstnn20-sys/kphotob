# Browser printing needs no environment variables.
# RP30 USB bridge defaults:
# RP30_CONNECTION=usb
# RP30_PRINTER_NAME=RP30
# For an RP30 on the network:
# RP30_CONNECTION=lan
# RP30_HOST=192.168.1.50
# RP30_PORT=9100
# Vercel environment variable (replace with your deployed app origin):
# NEXT_PUBLIC_PRINT_BRIDGE_URL=http://127.0.0.1:4173
# Bridge computer environment variable:
RP30_ALLOWED_ORIGINS=https://kixclicks.vercel.app/
